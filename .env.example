# Copy to .env (which is gitignored) and fill in.

# The name the twin answers as. Used in system prompts and in the question sheet.
PERSONA_NAME=

# Needed for training and for the demo.
# Create a token at https://modal.com/settings/tokens
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Optional. The default base model is public, so this is only needed for gated models
# or to avoid Hugging Face rate limits.
HF_TOKEN=

# Optional: GPU type for Modal runs. Valid: T4, L4, A10, L40S, A100-40GB, ...
# A comma-separated list is tried in order, which avoids long waits when one type is busy.
ANOTHER_ME_GPU=L4,A10
